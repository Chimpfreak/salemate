# Google AI Studio API Key (for live + Live AI Parse and inbound email extraction)
# Leave blank to use Salemate v3's built-in deterministic pitch-safe fallback parser.
GEMINI_API_KEY=

# Resend API Key (for live human-gated outbound email dispatch & inbound webhooks)
# Leave blank to use Salemate v3's built-in simulated dispatch receipt mode.
RESEND_API_KEY=

# Verified sender address in Resend (default: onboarding@resend.dev)
SALEMATE_SENDER_EMAIL=onboarding@resend.dev

# Optional: Public URL for Smart Deal Room links in emails
NEXT_PUBLIC_APP_URL=http://localhost:3000
